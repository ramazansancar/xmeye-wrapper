# xmeye-wrapper — ortam değişkenleri örneği.
# Kopyala: cp .env.example .env  (ve değerleri doldur). docker compose ve `go run ./server` bunu okur.
# .env GİZLİDİR (kamera şifresi) — .gitignore'da, paylaşma.

XMEYE_NAME=camera          # cihaz adı (arayüzde görünür)
XMEYE_SERIAL=              # kamera seri no (Cloud ID)
XMEYE_USER=               # kullanıcı adı
XMEYE_PASS=               # şifre
XMEYE_CHANNELS=16         # kanal sayısı
XMEYE_ADDR=:8080          # dinleme adresi (opsiyonel)
